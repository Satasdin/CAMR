// Figure 4.5: Architecture of CAMR v2, the deployed engine on the Mac (code folder ~/Developer/engram).
digraph architecture_v2 {
  rankdir=TB;
  graph [fontname="Helvetica" fontsize=11 bgcolor="white" pad=0.25 nodesep=0.35 ranksep=0.45 newrank=true];
  node [fontname="Helvetica" fontsize=10.5 shape=box style="rounded,filled" fillcolor="#f3f5f9" color="#9aa3b2" penwidth=1.1 fontcolor="#111111" margin="0.14,0.07"];
  edge [fontname="Helvetica" fontsize=9 color="#52514e" fontcolor="#52514e" arrowsize=0.7 penwidth=1.0];
  graph [ranksep=0.5];

  subgraph cluster_ui {
    label="Interfaces"; fontname="Helvetica-Bold"; color="#2a78d6"; style="rounded"; penwidth=1.3;
    page [label="Browser page (index.html)\nSimulation · Chat · Errands · Brain" fillcolor="#e9f1fb" color="#2a78d6"];
    cli  [label="Ruler command line\nrun · errands · speed · chart · life"];
  }

  subgraph cluster_app {
    label="Application"; fontname="Helvetica-Bold"; color="#9aa3b2"; style="rounded"; penwidth=1.2;
    server [label="App server (app/server.py)\n127.0.0.1:8765 · host, origin and token checks\none job at a time (lock)"];
    sim    [label="Simulation (app/sim.py)\na life day by day, in its own memory"];
    agent  [label="Agent (agent.py)\nten tools · exactly one call ·\nparse · grade"];
    ruler  [label="Ruler (ruler/)\nlives · contenders · harness ·\ngrade · errands · speed · chart"];
  }

  subgraph cluster_mem {
    label="Memory engine"; fontname="Helvetica-Bold"; color="#1baf7a"; style="rounded"; penwidth=1.4;
    memory   [label="Memory (memory.py)\nremember · choose · recall · answer" fillcolor="#e8f7f0" color="#1baf7a"];
    rooms    [label="Rooms (rooms.py)\nplace (Eq. 4.3) · add · fetch · save"];
    notebook [label="Notebook (notes.py)\nwrite notes · lay the desk ·\nturn keys (RoPE) when needed"];
    events   [label="Event log + Looks (events.py)\nattention of layers 12, 16, 20, 24 per word\nused if share ≥ 0.10 (Eq. 4.5)"];
    layout   [label="Layout (view/layout.py)\nt-SNE positions of moments"];
  }

  subgraph cluster_models {
    label="Frozen models (MLX, Apple-silicon GPU)"; fontname="Helvetica-Bold"; color="#eb6834"; style="rounded"; penwidth=1.3;
    reader   [label="Reader: Qwen3-1.7B-4bit\ngreedy · thinking off · ≤ 40 tokens" fillcolor="#fdeee6" color="#eb6834"];
    embedder [label="Embedder:\nQwen3-Embedding-0.6B-4bit-DWQ" fillcolor="#fdeee6" color="#eb6834"];
  }

  subgraph cluster_ssd {
    label="SSD: one folder per memory, plus the records"; fontname="Helvetica-Bold"; color="#2a78d6"; style="rounded"; penwidth=1.3;
    files [label="room-NNNNNN.notes (append-only, F_NOCACHE)\nindex.json · vectors.npy" shape=cylinder fillcolor="#e9f1fb" color="#2a78d6"];
    logf  [label="events.jsonl · layout.json" shape=cylinder fillcolor="#e9f1fb" color="#2a78d6"];
    recs  [label="records/ (dated test records)" shape=note style="filled" fillcolor="white" color="#2a78d6"];
  }

  v1 [label="CAMR v1 engine as a library\n(baseline contender, unchanged)" style="rounded,filled,dashed"];

  page -> server [label="JSON over HTTP"];
  cli -> ruler;
  server -> memory [label="remember · answer"];
  server -> agent [label="errand"];
  server -> sim;
  server -> layout [label="Brain"];
  sim -> memory [label="its own memory"];
  agent -> memory [label="answer with tools"];
  ruler -> memory [label="contender"];
  ruler -> v1 [label="contender" style=dashed];
  ruler -> recs;
  memory -> embedder [label="embed moment, question"];
  memory -> rooms;
  memory -> notebook;
  memory -> events;
  memory -> reader [label="generate from the desk"];
  notebook -> reader [label="read once to write notes"];
  rooms -> files [label="append · burst read" dir=both];
  events -> logf;
  layout -> logf;
  v1 -> reader [style=dashed];
  v1 -> embedder [style=dashed];
}
