// Figure 4.1: Context diagram of CAMR (both versions). Dashed = CAMR v1 only.
digraph context {
  rankdir=LR;
  graph [fontname="Helvetica" fontsize=11 bgcolor="white" pad=0.25 nodesep=0.35 ranksep=0.45 newrank=true];
  node [fontname="Helvetica" fontsize=10.5 shape=box style="rounded,filled" fillcolor="#f3f5f9" color="#9aa3b2" penwidth=1.1 fontcolor="#111111" margin="0.14,0.07"];
  edge [fontname="Helvetica" fontsize=9 color="#52514e" fontcolor="#52514e" arrowsize=0.7 penwidth=1.0];
  graph [nodesep=0.45 ranksep=1.3 labelloc="b" labeljust="c" fontsize=9 fontcolor="#52514e"
         label="Solid: both versions, or CAMR v2.   Dashed: CAMR v1 only.   In CAMR v2 nothing leaves the Mac after the first model download."];

  camr [label="0\nCAMR\nCapability-Adaptive\nMemory Retrieval\n\nv1: research engine\nv2: deployed engine" shape=circle
        style="filled" fillcolor="#e8f7f0" color="#1baf7a" penwidth=1.8 fontname="Helvetica-Bold" fontsize=11 width=2.4 fixedsize=true];

  user       [label="User of an\non-device assistant" style="filled" fillcolor="white" color="#2a78d6" penwidth=1.3];
  researcher [label="Researcher\n(student, supervisor,\nexaminer)" style="filled" fillcolor="white" color="#2a78d6" penwidth=1.3];
  bench      [label="Public benchmark files\nPopQA · HotpotQA ·\n2WikiMultiHopQA · GSM8K" style="filled,dashed" fillcolor="#e9f1fb" color="#2a78d6"];
  hub        [label="Model hub\n(Hugging Face)" style="filled" fillcolor="white"];
  ollama     [label="Local model runtime\n(Ollama, same machine)" style="filled,dashed" fillcolor="#fdeee6" color="#eb6834"];
  cloud      [label="Cloud reference model\nKimi K3 (Moonshot API)" style="filled,dashed" fillcolor="#fdeee6" color="#eb6834"];
  n8n        [label="Automation platform\n(n8n workflows)" style="filled,dashed" fillcolor="white"];
  web        [label="Web lookup sources\nDuckDuckGo · Wikipedia" style="filled,dashed" fillcolor="#e6f6f8" color="#0a6670"];

  {rank=min; user; researcher; bench; hub;}
  {rank=max; ollama; cloud; n8n; web;}

  user -> camr       [label="moments, notes, files,\nquestions, errands, feedback"];
  camr -> user       [label="answers, tool calls,\nrecalled moments, Brain replay" constraint=false];
  researcher -> camr [label="configurations, persona and seed,\ncontender, commands"];
  camr -> researcher [label="test records, tables,\ncharts, logs" constraint=false];
  bench -> camr      [label="questions, gold answers,\nsupporting documents" style=dashed];
  hub -> camr        [label="model weights\n(first run only)"];

  camr -> ollama     [label="prompts" style=dashed];
  ollama -> camr     [label="generated text,\ntoken counts, timings" style=dashed constraint=false];
  camr -> cloud      [label="prompts: ceiling, ceiling_rag,\nescalated questions" style=dashed];
  cloud -> camr      [label="answers, token counts" style=dashed constraint=false];
  camr -> n8n        [label="answers, cost meter" style=dashed];
  n8n -> camr        [label="teach, forget, ask\n(HTTP on localhost)" style=dashed constraint=false];
  camr -> web        [label="subject of a general question\n(never a personal one)" style=dashed];
  web -> camr        [label="page text and its link" style=dashed constraint=false];
}
