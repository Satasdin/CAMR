<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed only so the app can reach Ollama on the user's own computer over Wi-Fi
     (Ollama serves http://<computer-ip>:11434). On-device mode makes no network calls. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
